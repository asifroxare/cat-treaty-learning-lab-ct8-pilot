# CT6 runtime only. Never commit a real .env file.
CT6_HOST=0.0.0.0
CT6_PORT=8000
CT6_LOG_LEVEL=info

# Comma-separated explicit origins. Wildcard origins are rejected.
CT6_CORS_ORIGINS=http://localhost:5173
CT6_CORS_ALLOW_CREDENTIALS=false

# CT8 execution boundary is OFF until independently validated and accepted.
CT8_ISOLATED_RUNS=false
CT8_ISOLATION_DEADLINE_SECONDS=30
CT8_ISOLATION_MAX_CONCURRENCY=1
